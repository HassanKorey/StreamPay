# StreamPay App Environment Configuration Template
# Copy this file to .env.local and update with your actual credentials.
# NEVER commit real private keys or secrets to version control.

# Stellar Network & Soroban RPC Configuration
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban Contract Addresses (replace with your deployed contract IDs)
NEXT_PUBLIC_CONTRACT_ID=your_streampay_contract_id_here
NEXT_PUBLIC_USDC_ADDRESS=your_usdc_asset_contract_id_here
